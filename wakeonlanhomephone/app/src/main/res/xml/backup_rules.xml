<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for the Home Phone helper.
   The MQTT credentials, per-device PC secrets and the widget wake token must never leave
   the device through cloud backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="mqtt_config.xml"/>
    <exclude domain="sharedpref" path="HomePhoneDevicePrefs.xml"/>
    <exclude domain="sharedpref" path="widget_security.xml"/>
</full-backup-content>
