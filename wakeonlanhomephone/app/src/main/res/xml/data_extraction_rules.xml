<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for the Home Phone helper.
   Exclude the same secret-bearing preferences from both cloud backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mqtt_config.xml"/>
        <exclude domain="sharedpref" path="HomePhoneDevicePrefs.xml"/>
        <exclude domain="sharedpref" path="widget_security.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mqtt_config.xml"/>
        <exclude domain="sharedpref" path="HomePhoneDevicePrefs.xml"/>
        <exclude domain="sharedpref" path="widget_security.xml"/>
    </device-transfer>
</data-extraction-rules>
