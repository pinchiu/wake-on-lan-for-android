<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for the Remote Phone (Android 12+).
   The shared secrets and device profiles must never leave the device through
   cloud backup or device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="security_settings.xml"/>
        <exclude domain="sharedpref" path="RemoteControlPrefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="security_settings.xml"/>
        <exclude domain="sharedpref" path="RemoteControlPrefs.xml"/>
    </device-transfer>
</data-extraction-rules>
