<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for the Remote Phone.
   The shared secrets and device profiles must never leave the device through
   Android Auto Backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="security_settings.xml"/>
    <exclude domain="sharedpref" path="RemoteControlPrefs.xml"/>
</full-backup-content>
